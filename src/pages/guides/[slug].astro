---
import GuideLayout from "../../layouts/GuideLayout.astro";
import guidesData from "../../data/guides.json";
import sourcesData from "../../data/sources.json";
import type { GuidePost } from "../../lib/schema/guide";
import type { SourceRecord } from "../../lib/schema/common";

export function getStaticPaths() {
  const guides = guidesData as GuidePost[];
  const sources = sourcesData as SourceRecord[];
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: {
      guide,
      sources: sources.filter((source) => guide.sourceIds.includes(source.id)),
    },
  }));
}

interface Props {
  guide: GuidePost;
  sources: SourceRecord[];
}

const { guide, sources } = Astro.props;

const guideUrl = `https://lagoslifeguide.app/guides/${guide.slug}/`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: guide.title,
    description: guide.summary,
    dateModified: guide.updatedAt,
    inLanguage: "en",
    isAccessibleForFree: true,
    about: { "@type": "VideoGame", name: "Lagos Life", url: "https://lagoslife.app" },
    mainEntityOfPage: guideUrl,
    citation: guide.sourceIds,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://lagoslifeguide.app/" },
      { "@type": "ListItem", position: 2, name: "Guides", item: "https://lagoslifeguide.app/guides/" },
      { "@type": "ListItem", position: 3, name: guide.title, item: guideUrl },
    ],
  },
];
---

<GuideLayout guide={guide} sources={sources} jsonLd={jsonLd} />
