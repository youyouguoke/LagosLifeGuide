---
import BaseLayout from "../layouts/BaseLayout.astro";

const checkedAt = "2026-10-19";
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Can you withdraw Lagos Life naira as real money?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. The official terms state that in-game naira has no real-world value and cannot be cashed out, sold or transferred outside the game (section 3, checked 2026-10-19).",
      },
    },
    {
      "@type": "Question",
      name: "Can you top up Lagos Life with real money?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, optionally. Real-money top-ups buy in-game naira only, processed by the game's payment provider, Bachs. The game never sees card details (official terms section 3 and privacy policy).",
      },
    },
    {
      "@type": "Question",
      name: "What if you paid but received nothing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The official terms, section 3, commit to fixing or refunding cases where a payment went through but nothing arrived, or where you were charged twice. Contact the developer in-game.",
      },
    },
  ],
};
---

<BaseLayout
  title="Lagos Life Payments & Withdrawal: Top-Ups In, No Cash-Out (Official Rule)"
  description="Can you cash out Lagos Life naira? No — the official terms say game currency has no real-world value. Top-ups, refunds and payment safety, quoted with check dates."
  canonicalPath="/payments/"
  jsonLd={[faqJsonLd]}
  ogImage="/images/og-payments.jpg"
>
  <div class="mx-auto max-w-[860px] px-margin py-space-xl md:px-margin-tablet lg:px-margin-desktop">
    <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-label-md text-on-surface-variant">
      <a href="/" class="hover:text-primary">Home</a>
      <span class="text-outline" aria-hidden="true">/</span>
      <span aria-current="page" class="text-on-surface">Payments & Withdrawal</span>
    </nav>

    <h1 class="text-display-hero-mobile font-extrabold tracking-tight text-on-surface md:text-display-hero">
      Lagos Life Payments & Withdrawal
    </h1>

    <div class="mt-6 rounded-2xl border-l-4 border-primary bg-surface-container-low p-space-md">
      <div class="font-label-md text-label-md font-bold uppercase tracking-wide text-primary">Quick answer</div>
      <p class="mt-1 text-body-lg leading-relaxed text-on-surface">
        <strong>Money goes in, it never comes out.</strong> Real-money top-ups buy in-game naira
        (optionally, via the provider Bachs), but the official terms state game currency
        "have no real-world value and can't be cashed out, sold or transferred outside the game".
      </p>
      <p class="mt-2 text-body-sm text-on-surface-variant">
        Source: <a href="https://lagoslife.app/terms" class="text-primary hover:underline" rel="noopener">lagoslife.app/terms</a>,
        section 3 ("Game money and purchases") · checked <time datetime={checkedAt}>{checkedAt}</time>
      </p>
    </div>

    <h2 class="mt-space-lg font-headline-md text-headline-md font-extrabold text-on-surface">What the terms actually say</h2>
    <blockquote class="mt-3 rounded-2xl border border-outline-variant/40 bg-surface-container-lowest p-space-md text-body-lg leading-relaxed text-on-surface-variant">
      "In-game naira, items, houses and jobs are part of the game. They have no real-world value
      and can't be cashed out, sold or transferred outside the game. When you top up your wallet
      with real money, you're buying in-game naira. Payments are processed by our payment
      provider, Bachs. Purchases are final once delivered. If a payment went through but nothing
      arrived, or you were charged twice, contact us and we'll fix it or refund you."
      <footer class="mt-2 text-body-sm">— Lagos Life Terms of Service, section 3</footer>
    </blockquote>

    <h2 class="mt-space-lg font-headline-md text-headline-md font-extrabold text-on-surface">Practical takeaways</h2>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-body-md leading-relaxed text-on-surface-variant">
      <li><strong>Never "buy" game naira from another player</strong> — transfers outside the game are against the terms and unrecoverable.</li>
      <li><strong>Payment problems are refundable by policy</strong>: missing delivery or double charges are explicitly covered (section 3). The developer's privacy policy adds that card details are handled by Bachs only — the game keeps just a payment reference.</li>
      <li><strong>We cannot touch payments.</strong> LagosLifeGuide is an independent guide; balance or purchase issues go to the developer in-game.</li>
    </ul>

    <h2 class="mt-space-lg font-headline-md text-headline-md font-extrabold text-on-surface">Related</h2>
    <div class="mt-space-sm grid gap-3 sm:grid-cols-3">
      <a href="/age-limit/" class="rounded-2xl border border-outline-variant/40 bg-surface-container-lowest p-space-md transition-all hover:-translate-y-0.5 hover:border-primary/50">
        <div class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">Rule</div>
        <div class="mt-1 font-headline-sm text-headline-sm font-extrabold text-on-surface">Age limit: 18+</div>
      </a>
      <a href="/account-help/" class="rounded-2xl border border-outline-variant/40 bg-surface-container-lowest p-space-md transition-all hover:-translate-y-0.5 hover:border-primary/50">
        <div class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">Accounts</div>
        <div class="mt-1 font-headline-sm text-headline-sm font-extrabold text-on-surface">Account & password recovery</div>
      </a>
      <a href="/tools/first-week-planner/" class="rounded-2xl border border-outline-variant/40 bg-surface-container-lowest p-space-md transition-all hover:-translate-y-0.5 hover:border-primary/50">
        <div class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">Free</div>
        <div class="mt-1 font-headline-sm text-headline-sm font-extrabold text-on-surface">First Week Planner</div>
      </a>
    </div>
  </div>
</BaseLayout>
