---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VerificationBadge from "../../components/VerificationBadge.astro";
import sourcesData from "../../data/sources.json";
import evidenceData from "../../data/evidence.json";
import type { SourceRecord, EvidenceRecord, EvidenceType } from "../../lib/schema/common";

const sources = sourcesData as SourceRecord[];
const evidence = evidenceData as EvidenceRecord[];
const lastChecked = "2026-10-09";

const evidenceTypeLabels: Record<EvidenceType, string> = {
  official: "Official",
  in_game_test: "In-game test",
  community_report: "Community report",
  third_party_guide: "Third-party guide",
};

const evidenceTypeFilters = (Object.keys(evidenceTypeLabels) as EvidenceType[]).filter((type) =>
  sources.some((s) => s.evidenceType === type),
);

const typeIcons: Record<EvidenceType, string> = {
  official: "M12 3l7 4v5c0 4.4-3 8.4-7 9-4-.6-7-4.6-7-9V7l7-4z",
  in_game_test: "M5 12h14M5 12a7 7 0 0114 0M5 12v5a2 2 0 002 2h10a2 2 0 002-2v-5",
  community_report: "M17 8a3 3 0 11-6 0 3 3 0 016 0zM5 20c0-3.3 2.7-6 6-6s6 2.7 6 6",
  third_party_guide: "M4 19.5A2.5 2.5 0 016.5 17H20M4 19.5A2.5 2.5 0 006.5 22H20V2H6.5A2.5 2.5 0 004 4.5v15z",
};

const tierExplanations: {
  status: "verified" | "reported" | "unverified" | "conflicted";
  tierLabel: string;
  title: string;
  description: string;
  criteriaTitle: string;
  criteria: string[];
}[] = [
  {
    status: "verified",
    tierLabel: "Deterministic",
    title: "Confirmed by review or test",
    description:
      "Checked against our verification rules as of the stated date: either a documented review of the official source, or an in-game test we recorded ourselves.",
    criteriaTitle: "What it requires",
    criteria: [
      "Document review with access date, or a dated in-game observation",
      "The value affects calculations only in this state",
      "Re-checked on a schedule and when players report a change",
    ],
  },
  {
    status: "reported",
    tierLabel: "Reported lead",
    title: "Player report, not yet confirmed",
    description:
      "A traceable player report exists, but we have not finished verifying it. A report is treated as a lead, never as a confirmed fact.",
    criteriaTitle: "What it requires",
    criteria: [
      "Report has a traceable origin we can follow up",
      "Value stays out of deterministic calculations",
      "Queued for maintainer review against the live game",
    ],
  },
  {
    status: "unverified",
    tierLabel: "Pending",
    title: "Not enough evidence yet",
    description:
      "We have not collected enough evidence to say anything. The value is shown as unknown rather than estimated.",
    criteriaTitle: "What it requires",
    criteria: [
      "Never substituted with speculative averages or 0 placeholders",
      "Shown as unknown in every calculator and guide",
      "Upgraded only after a real review or test is recorded",
    ],
  },
  {
    status: "conflicted",
    tierLabel: "Open conflict",
    title: "Credible sources disagree",
    description:
      "Two credible sources state different things and the disagreement is unresolved. We say so openly instead of picking one silently.",
    criteriaTitle: "What it requires",
    criteria: [
      "The disagreement is documented on this page",
      "No arithmetic averaging and no silent guesses",
      "Resolved only when new evidence settles the question",
    ],
  },
];

const methodLabels: Record<EvidenceRecord["method"], string> = {
  document_review: "Document review",
  in_game_test: "In-game test",
  community_review: "Community review",
};
---

<BaseLayout
  title="Sources & Verification — LagosLifeGuide.app"
  description="How LagosLifeGuide.app sources, verifies, and updates its Lagos Life game data — including how we handle conflicts and errors."
  canonicalPath="/sources/"
>
  <div class="mx-auto w-full max-w-[1200px] px-margin py-space-lg md:px-margin-tablet lg:px-margin-desktop">
    <!-- Top banner & breadcrumb row -->
    <div class="flex flex-wrap items-center justify-between gap-space-sm rounded-2xl bg-surface-container-lowest p-space-md shadow-card">
      <nav aria-label="Breadcrumb" class="flex items-center gap-space-xs text-label-md text-on-surface-variant">
        <a href="/" class="flex items-center gap-1 transition-colors hover:text-primary">Home</a>
        <span class="text-outline-variant">/</span>
        <span class="text-label-lg text-on-surface">Sources &amp; Verification</span>
      </nav>
      <div class="flex items-center gap-2">
        <div class="flex items-center gap-1.5 rounded-full bg-surface-container-low px-3 py-1 text-label-sm text-primary">
          <span class="h-2 w-2 animate-pulse rounded-full bg-primary-container"></span>
          <span>Data integrity policy</span>
        </div>
        <div class="hidden items-center gap-1 rounded-full bg-surface-container px-3 py-1 text-label-sm text-on-surface-variant sm:flex">
          <span>Last checked: {lastChecked}</span>
        </div>
      </div>
    </div>

    <!-- Hero section -->
    <section class="py-space-md">
      <div class="relative overflow-hidden rounded-2xl bg-surface-container-lowest p-space-xl shadow-card">
        <div class="relative z-10 flex max-w-3xl flex-col gap-space-sm">
          <div class="inline-flex w-fit items-center gap-2 rounded-full bg-surface-container-low px-3 py-1 text-label-md text-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 3l7 3v5c0 4.4-3 8.4-7 9-4-.6-7-4.6-7-9V6l7-3z" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>Verification framework &amp; integrity policy</span>
          </div>
          <h1 class="text-display-hero font-bold tracking-tight text-on-surface">How we verify game information</h1>
          <p class="text-body-lg leading-relaxed text-on-surface-variant">
            Understand what is confirmed, what remains uncertain, and where our information comes from.
            Every field that can affect a calculation carries its own status and source — page-level
            labels never override an unverified field.
          </p>
        </div>

        <!-- 3 core principles -->
        <div class="relative z-10 mt-space-xl grid grid-cols-1 gap-space-md pt-space-lg md:grid-cols-3">
          <div class="flex flex-col gap-2 rounded-xl bg-surface-container-low/70 p-space-md">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-surface-container-lowest text-primary shadow-card">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 11l3 3 8-8M20 12v6a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <h2 class="text-headline-sm font-semibold text-on-surface">Claim-Specific Evidence</h2>
            <p class="text-body-sm text-on-surface-variant">
              Every value is linked to a recorded source — the game's own site or client bundle, a dated
              in-game observation, or a traceable player report — with the access date stated.
            </p>
          </div>
          <div class="flex flex-col gap-2 rounded-xl bg-surface-container-low/70 p-space-md">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-surface-container-lowest text-primary shadow-card">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <h2 class="text-headline-sm font-semibold text-on-surface">No Zero or Fabricated Data</h2>
            <p class="text-body-sm text-on-surface-variant">
              If a value has not been verified, we mark it as unverified instead of substituting
              speculative averages or 0 placeholders. Unknown means unknown.
            </p>
          </div>
          <div class="flex flex-col gap-2 rounded-xl bg-surface-container-low/70 p-space-md">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-surface-container-lowest text-primary shadow-card">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <h2 class="text-headline-sm font-semibold text-on-surface">Transparent Audit Trail</h2>
            <p class="text-body-sm text-on-surface-variant">
              Every verification is recorded as a dated, method-tagged entry in the audit log below,
              including the artifact path when one exists. Nothing is verified silently.
            </p>
          </div>
        </div>

        <!-- Audit trail: real evidence entries -->
        <div class="relative z-10 mt-space-lg">
          <h2 class="text-label-sm font-bold uppercase tracking-wider text-primary">Audit log — recorded entries</h2>
          {
            evidence.length === 0 ? (
              <p class="mt-space-sm text-body-md text-on-surface-variant">
                No verification entries recorded yet.
              </p>
            ) : (
              <ul class="mt-space-sm flex flex-col gap-space-sm">
                {evidence.map((record) => (
                  <li class="flex flex-col gap-space-xs rounded-xl bg-surface-container-lowest p-space-md shadow-card sm:flex-row sm:items-start sm:gap-space-md">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-surface-container-low text-primary">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6z" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M14 2v6h6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </div>
                    <div class="min-w-0">
                      <p class="text-label-lg font-semibold text-on-surface">
                        {methodLabels[record.method] ?? record.method} · {record.observedAt}
                      </p>
                      <p class="mt-space-xs text-body-sm text-text-muted">
                        Source: {record.sourceId} · Game: {record.gameUrl}
                      </p>
                      {record.observation && (
                        <p class="mt-space-sm text-body-md text-on-surface-variant">{record.observation}</p>
                      )}
                      {record.artifactPath && (
                        <p class="mt-space-sm text-body-sm text-text-muted">
                          Artifact: <code class="rounded bg-surface-container px-1.5 py-0.5">{record.artifactPath}</code>
                        </p>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
    </section>

    <!-- Section 2: verification statuses explained -->
    <section class="py-space-lg">
      <div class="mb-space-lg flex flex-col justify-between gap-space-sm md:flex-row md:items-end">
        <div>
          <span class="text-label-sm font-bold uppercase tracking-wider text-primary">Standardized rating system</span>
          <h2 class="mt-1 text-headline-lg font-semibold text-on-surface">Our four field statuses</h2>
        </div>
        <p class="max-w-md text-body-md text-on-surface-variant">
          Look for these badges across all game-data pages and calculators to assess data reliability
          instantly. Every field that affects a calculation carries one of them.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-space-md md:grid-cols-2 lg:grid-cols-4">
        {
          tierExplanations.map(({ status, tierLabel, title, description, criteriaTitle, criteria }) => (
            <div class="flex flex-col justify-between rounded-2xl bg-surface-container-lowest p-space-lg shadow-card transition-all hover:-translate-y-1">
              <div class="flex flex-col gap-space-sm">
                <div class="flex items-center justify-between gap-2">
                  <VerificationBadge {status} />
                  <span class="text-label-sm text-on-surface-variant">{tierLabel}</span>
                </div>
                <h3 class="mt-2 text-headline-md font-semibold text-on-surface">{title}</h3>
                <p class="text-body-md text-on-surface-variant">{description}</p>
                <div class="mt-space-sm rounded-xl bg-surface-container-low p-space-sm">
                  <div class="mb-1 text-label-sm font-bold uppercase tracking-wider text-on-surface-variant">
                    {criteriaTitle}
                  </div>
                  <ul class="space-y-1.5 text-body-sm text-on-surface">
                    {criteria.map((item) => (
                      <li class="flex items-start gap-1.5">
                        <svg
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          class="mt-0.5 shrink-0 text-primary"
                          aria-hidden="true"
                        >
                          <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              <div class="mt-space-md flex items-center justify-between pt-space-sm text-label-sm text-on-surface-variant">
                <span>Field-level, not page-level</span>
                <span class="font-semibold text-primary">Shown on every data field</span>
              </div>
            </div>
          ))
        }
      </div>
      <p class="mt-space-md text-body-md text-on-surface-variant">
        A <strong class="text-on-surface">verified</strong> label does not mean the data is valid forever —
        the game can change at any time, and affected fields are re-checked before the site is updated.
      </p>
    </section>

    <!-- Section 3: handling conflicting evidence -->
    <section class="py-space-md">
      <div class="relative overflow-hidden rounded-2xl bg-surface-container-low p-space-xl shadow-card">
        <div class="flex flex-col items-start justify-between gap-space-lg lg:flex-row lg:items-center">
          <div class="flex max-w-2xl flex-col gap-space-xs">
            <div class="flex items-center gap-2 text-label-md text-primary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 3v18M5 7l7-4 7 4M3 13l2-6 2 6a3 3 0 01-4 0zM17 13l2-6 2 6a3 3 0 01-4 0z" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="font-bold">Protocol in detail</span>
            </div>
            <h2 class="text-headline-lg font-semibold text-on-surface">Handling Conflicting Evidence &amp; Integrity</h2>
            <p class="leading-relaxed text-body-md text-on-surface-variant">
              What happens when two credible sources disagree? Rather than taking a silent average that
              misleads readers, we run a transparent conflict protocol. One real, unresolved example: the
              name &ldquo;Lagos Life&rdquo; is shared by two <em>different</em> published game instances —
              <a href="https://lagoslife.app" class="font-semibold text-primary transition-colors hover:text-brand-dark" target="_blank" rel="noopener noreferrer">lagoslife.app</a>
              (our confirmed target instance) and
              <a href="https://lagoslife.com.ng" class="font-semibold text-primary transition-colors hover:text-brand-dark" target="_blank" rel="noopener noreferrer">lagoslife.com.ng</a>
              (a different game by GreatCallie, on Google Play as com.greatcallie.lagoslife). Data from
              the two instances must never be mixed, so the second one stays in the source registry below
              purely to document the conflict.
            </p>
            <div class="mt-space-sm grid grid-cols-1 gap-space-md sm:grid-cols-2">
              <div class="flex gap-3 rounded-xl bg-surface-container-lowest p-space-md">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 shrink-0 text-primary" aria-hidden="true">
                  <path d="M7 7h10v10H7zM3 3h4v4M17 3h4v4M3 17h4v4M17 17h4v4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div>
                  <h3 class="text-headline-sm font-semibold text-on-surface">Explicit conflict tagging</h3>
                  <p class="mt-0.5 text-body-sm text-on-surface-variant">
                    The field is flagged <strong class="text-on-surface">Sources conflict</strong> and the
                    disagreement is explained on this page, not averaged into a compromise number.
                  </p>
                </div>
              </div>
              <div class="flex gap-3 rounded-xl bg-surface-container-lowest p-space-md">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 shrink-0 text-primary" aria-hidden="true">
                  <path d="M12 8v4l2 2M12 21a9 9 0 100-18 9 9 0 000 18z" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div>
                  <h3 class="text-headline-sm font-semibold text-on-surface">Kept out of calculations</h3>
                  <p class="mt-0.5 text-body-sm text-on-surface-variant">
                    Until the conflict is resolved, the value stays out of deterministic calculations —
                    the planner asks you to re-run with current data instead of extending stale results.
                  </p>
                </div>
              </div>
            </div>
          </div>
          <!-- Conflict resolution flow card -->
          <div class="flex w-full shrink-0 flex-col gap-space-sm rounded-2xl bg-surface-container-lowest p-space-lg shadow-card lg:w-80">
            <div class="flex items-center justify-between pb-space-xs">
              <span class="text-label-md font-bold text-on-surface">Conflict resolution flow</span>
              <span class="h-2 w-2 rounded-full bg-primary"></span>
            </div>
            <div class="space-y-3 text-body-sm">
              <div class="flex items-center gap-2 rounded-lg bg-surface-container-low p-2.5 text-on-surface">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary text-label-sm text-on-primary">1</span>
                <span>Disagreement found between credible sources</span>
              </div>
              <div class="flex justify-center text-outline-variant" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 5v14m0 0l-6-6m6 6l6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <div class="flex items-center gap-2 rounded-lg bg-surface-container p-2.5 text-on-surface">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary text-label-sm text-on-primary">2</span>
                <span>Field marked &ldquo;Sources conflict&rdquo; + explained here</span>
              </div>
              <div class="flex justify-center text-outline-variant" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 5v14m0 0l-6-6m6 6l6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <div class="flex items-center gap-2 rounded-lg bg-surface-container-low p-2.5 text-on-surface">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary text-label-sm text-on-primary">3</span>
                <span>Maintainers re-verify against the live game</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 4: reviewed source directory -->
    <section class="py-space-xl">
      <div class="mb-space-lg flex flex-col justify-between gap-space-md md:flex-row md:items-end">
        <div>
          <span class="text-label-sm font-bold uppercase tracking-wider text-primary">Audit database</span>
          <h2 class="mt-1 text-headline-lg font-semibold text-on-surface">Reviewed Source Directory</h2>
          <p class="mt-1 text-body-md text-on-surface-variant">
            Direct citations powering our game data. We do not list sources we have not actually reviewed.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2" id="sourceFilters">
          <button
            type="button"
            class="filter-btn rounded-full bg-primary px-3.5 py-1.5 text-label-md text-on-primary transition-all"
            data-filter="all"
          >
            All sources ({sources.length})
          </button>
          {
            evidenceTypeFilters.map((type) => (
              <button
                type="button"
                class="filter-btn rounded-full bg-surface-container-lowest px-3.5 py-1.5 text-label-md text-on-surface transition-all hover:bg-surface-container-low"
                data-filter={type}
              >
                {evidenceTypeLabels[type]} ({sources.filter((s) => s.evidenceType === type).length})
              </button>
            ))
          }
        </div>
      </div>

      <div class="flex flex-col gap-space-sm" id="sourcesContainer">
        {
          sources.map((source) => (
            <div
              class="source-card flex flex-col justify-between gap-space-md rounded-2xl bg-surface-container-lowest p-space-md transition-all hover:shadow-card-hover md:flex-row md:items-center"
              data-category={source.evidenceType}
            >
              <div class="flex items-start gap-space-md">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-surface-container-low text-primary">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d={typeIcons[source.evidenceType]} stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="flex min-w-0 flex-col">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="text-headline-sm font-semibold text-on-surface">{source.title}</h3>
                    <span class="inline-flex items-center gap-1 rounded-full bg-surface-container-low px-2.5 py-0.5 text-label-sm font-bold text-primary">
                      <span class="h-1.5 w-1.5 rounded-full bg-primary" />
                      {evidenceTypeLabels[source.evidenceType]}
                    </span>
                  </div>
                  {source.publisher && (
                    <p class="mt-1 text-body-sm text-text-muted">Publisher: {source.publisher}</p>
                  )}
                  <p class="mt-1 text-body-md text-on-surface-variant">{source.notes}</p>
                  <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-body-sm text-outline">
                    <a
                      href={source.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 break-all font-mono text-[11px] font-semibold text-primary transition-colors hover:text-brand-dark"
                    >
                      {source.url}
                    </a>
                    <span>Accessed: {source.accessedAt}</span>
                    <span>
                      Applies to:
                      {source.applicableGameUrl ? (
                        <a
                          href={source.applicableGameUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="font-semibold text-primary transition-colors hover:text-brand-dark"
                        >
                          {source.applicableGameUrl}
                        </a>
                      ) : (
                        " —"
                      )}
                    </span>
                  </div>
                </div>
              </div>
              <div class="flex shrink-0 items-center gap-space-sm self-end md:self-center">
                <a
                  href={source.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 rounded-full bg-surface-container-low px-3.5 py-2 text-label-md text-primary transition-all hover:bg-primary hover:text-on-primary"
                >
                  <span>Inspect reference</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Section 5: report an error -->
    <section class="mb-12 py-space-xl">
      <div class="rounded-2xl bg-surface-container-lowest p-space-xl shadow-card">
        <div class="grid grid-cols-1 gap-space-xl lg:grid-cols-12">
          <div class="flex flex-col justify-between lg:col-span-5">
            <div>
              <div class="mb-3 inline-flex w-fit items-center gap-2 rounded-full bg-surface-container-low px-3 py-1 text-label-md text-primary">
