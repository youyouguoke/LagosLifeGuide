---
import BaseLayout from "../../layouts/BaseLayout.astro";
import locationsJson from "../../data/locations.json";
import skillsJson from "../../data/skills-actions.json";
import { effectLabel } from "../../lib/game-data";

/**
 * Action finder: every recorded action in one searchable table — name, venue,
 * duration, cost, effect with units (pts/h or instant), the client bundle's
 * unlock requirement, the skill it trains, and our verification status.
 * Bundle semantics: `needs` values are points per in-game hour applied across
 * the action's duration; `instant` values apply once.
 */

interface SkillRow {
  id: string;
  name: string;
  status: string;
  checkedAt: string;
  locationId: string | null;
  locationName: string | null;
  minutes: number | null;
  cost: number | null;
  effect: string | null;
  requirement: string | null;
  skill: string | null;
}

const locName = new Map<string, string>();
for (const l of locationsJson as unknown as { id: string; name?: { value?: string } }[]) {
  locName.set(l.id, l.name?.value ?? l.id);
}

const raw = (skillsJson as unknown as {
  id: string;
  name: { value?: string; status?: string; checkedAt?: string };
  durationMinutes?: { value?: number };
  costAmount?: { value?: number | null };
  effectDescription?: { value?: string };
  locationId?: { value?: string };
  requirement?: { value?: string };
  skillKey?: { value?: string };
}[]);

// Disambiguate same-named actions with their venue (P0-5).
const nameCount = new Map<string, number>();
for (const a of raw) nameCount.set(a.name.value ?? a.id, (nameCount.get(a.name.value ?? a.id) ?? 0) + 1);

const rows: SkillRow[] = raw.map((a) => {
  const loc = a.locationId?.value ?? null;
  const lname = loc ? (locName.get(loc) ?? loc) : "—";
  const base = a.name.value ?? a.id;
  return {
    id: a.id,
    name: (nameCount.get(base) ?? 0) > 1 && loc ? `${base} (${lname})` : base,
    status: a.name.status ?? "unverified",
    checkedAt: a.name.checkedAt ?? "",
    locationId: loc,
    locationName: lname,
    minutes: a.durationMinutes?.value ?? null,
    cost: a.costAmount?.value ?? null,
    effect: effectLabel(a.effectDescription?.value ?? null),
    requirement: a.requirement?.value ?? null,
    skill: a.skillKey?.value ?? null,
  };
});

rows.sort((a, b) => a.name.localeCompare(b.name));

const locOptions = [...new Set(rows.map((r) => r.locationName).filter((n): n is string => n !== "—"))].sort();
const skillOptions = [...new Set(rows.map((r) => r.skill).filter((s): s is string => !!s))].sort();

const badge: Record<string, { text: string; cls: string }> = {
  verified: { text: "Verified", cls: "bg-primary-fixed text-on-primary-fixed" },
  reported: { text: "Reported", cls: "bg-tertiary-fixed text-on-tertiary-fixed" },
  unverified: { text: "Pending", cls: "bg-surface-container-highest text-on-surface-variant" },
  conflicted: { text: "Conflicted", cls: "bg-error-container text-on-error-container" },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "How many actions are in Lagos Life?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `Our extracted game-client data records ${rows.length} actions — everything from sleeping and cooking to UNILAG lectures, stadium matchdays and ATM hacking. Each row carries its own verification status and check date.`,
      },
    },
    {
      "@type": "Question",
      name: "What do the effect units mean?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Two kinds: 'Fun +10/h' raises the Fun need bar by ten points per in-game hour for as long as the action runs; 'Hunger +50 (instant)' applies once, immediately. Values come straight from the game client bundle, which uses exactly these two mechanisms.",
      },
    },
    {
      "@type": "Question",
      name: "What do the requirements mean?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Requirement values are the game client bundle's own unlock gates (for example 'Needs Coding 6' to Hack an ATM), extracted verbatim from the bundle on 2026-10-09 and re-verified 2026-10-19. Actions with no requirement shown have none in the client data.",
      },
    },
  ],
};
---

<BaseLayout
  title={`Lagos Life Action Finder: All ${rows.length} Actions, Filterable | LagosLifeGuide`}
  description={`Every recorded action in Lagos Life in one filterable table — venue, duration, cost, effect in pts/h or instant, unlock requirements, growth skills and per-row verification status. ${rows.length} actions from the verified game-client data.`}
  canonicalPath="/actions/"
  jsonLd={[faqJsonLd]}
  ogImage="/images/og-actions.jpg"
>
  <div class="mx-auto max-w-[1280px] px-margin py-space-xl md:px-margin-tablet lg:px-margin-desktop">
    <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-label-md text-on-surface-variant">
      <a href="/" class="hover:text-primary">Home</a>
      <span class="text-outline" aria-hidden="true">/</span>
      <span aria-current="page" class="text-on-surface">Action Finder</span>
    </nav>

    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-primary-fixed px-2.5 py-0.5 font-label-sm text-label-sm text-on-primary-fixed">{rows.length} actions</span>
      <span class="rounded-full bg-surface-container px-2.5 py-0.5 font-label-sm text-label-sm text-on-surface-variant">from verified game-client data</span>
    </div>
    <h1 class="mt-2 text-display-hero-mobile font-extrabold tracking-tight text-on-surface md:text-display-hero">
      Lagos Life Action Finder
    </h1>
    <p class="mt-3 max-w-3xl text-body-lg leading-relaxed text-on-surface-variant">
      Every action we have extracted from the game — where it happens, how long it takes, what it costs,
      and what it does. Effects are per-hour rates (<strong class="text-on-surface">Fun +10/h</strong>) or
      one-off values (<strong class="text-on-surface">Hunger +50 (instant)</strong>), exactly as the client
      bundle defines them. Requirements are the bundle's own unlock gates, extracted verbatim.
    </p>

    <div class="mt-space-lg grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <label for="action-search" class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">Search</label>
        <input id="action-search" type="search" placeholder="e.g. hack, sleep, jollof, degree…" autocomplete="off"
          class="mt-1 w-full rounded-xl border border-outline-variant/40 bg-surface-container-lowest px-4 py-3 text-body-md text-on-surface outline-none focus:border-primary" />
      </div>
      <div>
        <label for="action-location" class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">Venue</label>
        <select id="action-location" class="mt-1 w-full rounded-xl border border-outline-variant/40 bg-surface-container-lowest px-4 py-3 text-body-md text-on-surface outline-none focus:border-primary">
          <option value="">All</option>
          {locOptions.map((n) => <option value={n}>{n}</option>)}
        </select>
      </div>
      <div>
        <label for="action-skill" class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">Trains skill</label>
        <select id="action-skill" class="mt-1 w-full rounded-xl border border-outline-variant/40 bg-surface-container-lowest px-4 py-3 text-body-md text-on-surface outline-none focus:border-primary">
          <option value="">All</option>
          {skillOptions.map((s) => <option value={s}>{s.charAt(0).toUpperCase() + s.slice(1)}</option>)}
        </select>
      </div>
      <div class="grid grid-cols-2 gap-2">
        <div>
          <label for="action-maxmin" class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">Max min</label>
          <input id="action-maxmin" type="number" min="0" placeholder="Any"
            class="mt-1 w-full rounded-xl border border-outline-variant/40 bg-surface-container-lowest px-4 py-3 text-body-md text-on-surface outline-none focus:border-primary" />
        </div>
        <div>
          <label for="action-maxcost" class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">Max ₦</label>
          <input id="action-maxcost" type="number" min="0" placeholder="Any"
            class="mt-1 w-full rounded-xl border border-outline-variant/40 bg-surface-container-lowest px-4 py-3 text-body-md text-on-surface outline-none focus:border-primary" />
        </div>
      </div>
    </div>
    <p id="action-count" class="mt-2 text-body-sm text-on-surface-variant" aria-live="polite">
      Showing all {rows.length} actions
    </p>

    <div class="mt-3 overflow-x-auto rounded-2xl border border-outline-variant/40">
      <table class="w-full min-w-[980px] border-collapse text-left">
        <thead>
          <tr class="bg-surface-container font-label-md text-label-md uppercase tracking-wide text-secondary">
            <th class="px-4 py-3">Action</th>
            <th class="px-4 py-3">Venue</th>
            <th class="px-4 py-3 text-right">Min</th>
            <th class="px-4 py-3 text-right">Cost</th>
            <th class="px-4 py-3">Effect</th>
            <th class="px-4 py-3">Requirement</th>
            <th class="px-4 py-3">Skill</th>
            <th class="px-4 py-3">Status</th>
          </tr>
        </thead>
        <tbody id="action-rows">
          {rows.map((r) => (
            <tr class="border-t border-outline-variant/20 align-top transition-colors hover:bg-surface-container-low/60"
              data-name={r.name.toLowerCase()} data-location={r.locationName}
              data-skill={r.skill ?? ""} data-minutes={r.minutes ?? ""} data-cost={r.cost ?? ""}>
              <td class="px-4 py-3">
                <a href={`/game-data/${r.id}/`} class="font-semibold text-on-surface hover:text-primary hover:underline">{r.name}</a>
              </td>
              <td class="px-4 py-3 text-body-sm text-on-surface-variant">
                {r.locationId ? (
                  <a href={`/locations/${r.locationId}/`} class="hover:text-primary hover:underline">{r.locationName}</a>
                ) : r.locationName}
              </td>
              <td class="px-4 py-3 text-right text-body-sm tabular-nums">{r.minutes ?? "—"}</td>
              <td class="px-4 py-3 text-right text-body-sm tabular-nums">{r.cost != null ? `₦${r.cost.toLocaleString("en-NG")}` : "—"}</td>
              <td class="px-4 py-3 text-body-sm">{r.effect ?? "—"}</td>
              <td class="px-4 py-3 text-body-sm text-on-surface-variant">{r.requirement ?? (r.locationId ? `Be at ${r.locationName}` : "Anywhere")}</td>
              <td class="px-4 py-3 text-body-sm">{r.skill ? r.skill.charAt(0).toUpperCase() + r.skill.slice(1) : "—"}</td>
              <td class="px-4 py-3">
                <span class={`inline-block rounded-full px-2 py-0.5 font-label-sm text-label-sm ${badge[r.status]?.cls ?? badge.unverified.cls}`}>
                  {badge[r.status]?.text ?? "Pending"}
                </span>
                {r.checkedAt && <div class="mt-1 text-[11px] text-on-surface-variant">{r.checkedAt}</div>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-body-sm text-on-surface-variant">
      Status meanings: <strong>Verified</strong> — matches the game client bundle on file; <strong>Pending</strong> —
      present in the data but not yet independently corroborated; <strong>Reported</strong> — player-reported,
      unconfirmed. Each record page shows the underlying field values, sources and check dates.
    </p>
  </div>

  <script is:inline>
    (function () {
      var search = document.getElementById("action-search");
      var loc = document.getElementById("action-location");
      var skill = document.getElementById("action-skill");
      var maxmin = document.getElementById("action-maxmin");
      var maxcost = document.getElementById("action-maxcost");
      var count = document.getElementById("action-count");
      var rows = Array.prototype.slice.call(document.querySelectorAll("#action-rows tr"));
      var total = rows.length;
      function num(el) { var v = parseInt(el.value, 10); return isNaN(v) ? null : v; }
      function apply() {
        var q = (search.value || "").trim().toLowerCase();
        var l = loc.value, s = skill.value;
        var mm = num(maxmin), mc = num(maxcost);
        var shown = 0;
        rows.forEach(function (r) {
          var ok = (!q || r.dataset.name.indexOf(q) !== -1)
            && (!l || r.dataset.location === l)
            && (!s || r.dataset.skill === s)
            && (mm === null || (r.dataset.minutes !== "" && +r.dataset.minutes <= mm))
            && (mc === null || (r.dataset.cost !== "" && +r.dataset.cost <= mc));
          r.classList.toggle("hidden", !ok);
          if (ok) shown++;
        });
        count.textContent = shown === total
          ? "Showing all " + total + " actions"
          : "Showing " + shown + " of " + total + " actions";
      }
      [search, maxmin, maxcost].forEach(function (el) { el.addEventListener("input", apply); });
      [loc, skill].forEach(function (el) { el.addEventListener("change", apply); });
    })();
  </script>
</BaseLayout>
