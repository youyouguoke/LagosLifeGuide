---
import BaseLayout from "../../layouts/BaseLayout.astro";
import jobsJson from "../../data/jobs.json";
import locationsJson from "../../data/locations.json";
import type { GameJob } from "../../lib/schema/job";
import { cityFromWorkplace, formatNaira, ladderForJob } from "../../lib/jobs-ladder";

const jobs = jobsJson as unknown as GameJob[];
const locations = new Map(
  (locationsJson as { id: string; name?: { value?: string } }[]).map((l) => [
    l.id,
    l.name?.value ?? l.id,
  ]),
);

interface JobRow {
  slug: string;
  name: string;
  city: string;
  entryPay: number | null;
  topPay: number | null;
  gate: string;
  gated: boolean;
  workplace: string;
  shiftHours: number | null;
  checkedAt: string | undefined;
}

const rows: JobRow[] = jobs
  .map((j) => {
    const ladder = ladderForJob(j);
    const top = ladder.length > 0 ? ladder[ladder.length - 1].pay : null;
    const reqs = Array.isArray(j.entryRequirements?.value)
      ? (j.entryRequirements.value as string[])
      : [];
    const mins = typeof j.shiftDurationMinutes?.value === "number"
      ? j.shiftDurationMinutes.value
      : null;
    return {
      slug: j.id,
      name: j.name?.value ?? j.id,
      city: cityFromWorkplace(
        typeof j.workplace?.value === "string" ? j.workplace.value : null,
      ),
      entryPay: typeof j.payAmount?.value === "number" ? j.payAmount.value : null,
      topPay: top,
      gate: reqs.length > 0 ? reqs.join(", ") : "None",
      gated: reqs.length > 0,
      workplace: locations.get(j.workplace?.value ?? "") ?? j.workplace?.value ?? "Not yet verified",
      shiftHours: mins !== null ? Math.round((mins / 60) * 10) / 10 : null,
      checkedAt: j.payAmount?.checkedAt,
    };
  })
  .sort((a, b) => (b.entryPay ?? -1) - (a.entryPay ?? -1));
---

<BaseLayout
  title="Lagos Life Jobs & Pay by Rank: All 33 Careers"
  description="Compare all 33 Lagos Life careers by city, entry skill, workplace and pay at every rank. Each figure shows its verification status and check date."
  ogImage="/images/og-jobs.jpg"
  canonicalPath="/jobs/"
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://lagoslifeguide.app/" },
        { "@type": "ListItem", position: 2, name: "Jobs & Pay", item: "https://lagoslifeguide.app/jobs/" },
      ],
    },
  ]}
>
  <div class="mx-auto w-full max-w-[1280px] px-4 pb-12 pt-8 sm:px-6 lg:px-10">
    <nav aria-label="Breadcrumb" class="mb-4 text-body-sm text-on-surface-variant">
      <a href="/" class="hover:text-primary">Home</a>
      <span class="mx-2 text-outline" aria-hidden="true">/</span>
      <span aria-current="page" class="text-on-surface">Jobs & Pay</span>
    </nav>

    <h1 class="text-display-hero-mobile font-extrabold tracking-tight text-on-surface md:text-display-hero">
      Lagos Life Jobs and Pay by Rank
    </h1>
    <p class="mt-4 max-w-3xl text-body-lg leading-relaxed text-on-surface-variant">
      All 33 Lagos Life careers across Lagos, Abuja and Port Harcourt. Entry pay is the
      <strong class="text-on-surface">Level 1 wage for one shift</strong>; top pay is the
      <strong class="text-on-surface">Level 5 wage</strong>. A skill gate means you must reach the
      listed skill level before the career accepts you — no gate means you can apply on day one.
      Every figure carries its own verification status and check date; details live on each
      career page. All pay figures are
      <strong class="text-on-surface">base pay per shift, before adjustments and tax</strong> —
      in-game events and policies can move what you actually receive. Other guides sometimes
      show a different pay grade by default, so identical careers may not match their numbers exactly.
    </p>

    <!-- Filters -->
    <div class="mt-8 flex flex-col gap-3 rounded-card border border-outline-variant/40 bg-surface-container-lowest p-4 shadow-sm sm:flex-row sm:items-end">
      <div class="flex flex-1 flex-col gap-1">
        <label for="jobs-city" class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">City</label>
        <select id="jobs-city" class="rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface">
          <option value="all">All cities</option>
          <option value="Lagos">Lagos</option>
          <option value="Abuja">Abuja</option>
          <option value="Port Harcourt">Port Harcourt</option>
        </select>
      </div>
      <div class="flex flex-1 flex-col gap-1">
        <label for="jobs-gate" class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">Entry requirement</label>
        <select id="jobs-gate" class="rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface">
          <option value="all">Any</option>
          <option value="open">No skill gate</option>
          <option value="gated">Skill-gated</option>
        </select>
      </div>
      <div class="flex flex-1 flex-col gap-1">
        <label for="jobs-level" class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">Level</label>
        <select id="jobs-level" class="rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface">
          <option value="1" selected>Level 1 (entry)</option>
          <option value="2">Level 2</option>
          <option value="3">Level 3</option>
          <option value="4">Level 4</option>
          <option value="5">Level 5 (top)</option>
        </select>
      </div>
      <div class="flex flex-1 flex-col gap-1">
        <label for="jobs-sort" class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">Sort by pay</label>
        <select id="jobs-sort" class="rounded-lg border border-outline-variant bg-surface-container-lowest px-3 py-2 text-body-md text-on-surface">
          <option value="pay-desc">Pay · high to low</option>
          <option value="pay-asc">Pay · low to high</option>
        </select>
      </div>
      <p id="jobs-count" class="font-label-md text-label-md font-bold text-primary sm:pb-2" aria-live="polite">
        {rows.length} careers
      </p>
    </div>

    <!-- Desktop table -->
    <div class="mt-6 hidden overflow-x-auto rounded-card border border-outline-variant/40 bg-surface-container-lowest shadow-sm md:block">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-outline-variant/40 font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">
            <th scope="col" class="px-4 py-3">Career</th>
            <th scope="col" class="px-4 py-3">City</th>
            <th scope="col" class="px-4 py-3" id="jobs-pay-head">L1 pay / shift</th>
            <th scope="col" class="px-4 py-3">Skill gate</th>
            <th scope="col" class="px-4 py-3">Workplace</th>
            <th scope="col" class="px-4 py-3">Shift</th>
            <th scope="col" class="px-4 py-3"><span class="sr-only">Compare</span></th>
          </tr>
        </thead>
        <tbody id="jobs-tbody">
          {rows.map((r) => (
            <tr
              class="job-row border-b border-outline-variant/20 last:border-0 hover:bg-surface-container/40"
              data-city={r.city}
              data-gated={r.gated ? "true" : "false"}
              data-levels={JSON.stringify(Object.fromEntries(ladderForJob(jobs.find((x) => x.id === r.slug)!).map((s) => [s.level, s.pay])))}
              data-name={r.name}
              data-gate={r.gate}
              data-workplace={r.workplace}
              data-shift={r.shiftHours ?? ""}
            >
              <td class="px-4 py-3">
                <a href={`/jobs/${r.slug}/`} class="font-headline-sm text-headline-sm font-extrabold text-primary hover:underline">
                  {r.name}
                </a>
              </td>
              <td class="px-4 py-3 text-body-md text-on-surface-variant">{r.city}</td>
              <td class="px-4 py-3 font-body-md text-body-md font-bold text-on-surface">
                <span class="js-pay">{r.entryPay !== null ? formatNaira(r.entryPay) : "Data Pending"}</span>
              </td>
              <td class="px-4 py-3 text-body-md text-on-surface-variant">{r.gate}</td>
              <td class="px-4 py-3 text-body-md text-on-surface-variant">{r.workplace}</td>
              <td class="px-4 py-3 text-body-md text-on-surface-variant">
                {r.shiftHours !== null ? `${r.shiftHours} h` : "Data Pending"}
              </td>
              <td class="px-4 py-3">
                <button type="button" class="jobs-compare-btn rounded-full border border-outline-variant px-3 py-1 text-label-md font-bold text-primary hover:bg-surface-container" data-slug={r.slug}>
                  + Compare
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Mobile cards -->
    <div id="jobs-cards" class="mt-6 grid grid-cols-1 gap-4 md:hidden">
      {rows.map((r) => (
        <div
          class="job-row block rounded-card border border-outline-variant/40 bg-surface-container-lowest p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md"
          data-city={r.city}
          data-gated={r.gated ? "true" : "false"}
          data-levels={JSON.stringify(Object.fromEntries(ladderForJob(jobs.find((x) => x.id === r.slug)!).map((s) => [s.level, s.pay])))}
          data-name={r.name}
          data-gate={r.gate}
          data-workplace={r.workplace}
          data-shift={r.shiftHours ?? ""}
        >
          <a href={`/jobs/${r.slug}/`} class="block">
            <div class="flex items-start justify-between gap-3">
              <h2 class="font-headline-sm text-headline-sm font-extrabold text-on-surface">{r.name}</h2>
              <span class="rounded-full bg-surface-container px-2.5 py-1 font-label-md text-label-md font-bold text-secondary">
                {r.city}
              </span>
            </div>
            <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-body-md">
              <div>
                <dt class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">Pay / shift</dt>
                <dd class="font-bold text-on-surface"><span class="js-pay">{r.entryPay !== null ? formatNaira(r.entryPay) : "Data Pending"}</span></dd>
              </div>
              <div>
                <dt class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">Skill gate</dt>
                <dd class="text-on-surface-variant">{r.gate}</dd>
              </div>
              <div class="col-span-2">
                <dt class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">Workplace</dt>
                <dd class="text-on-surface-variant">
                  {r.workplace} · {r.shiftHours !== null ? `${r.shiftHours} h shifts` : "shift length pending"}
                </dd>
              </div>
            </dl>
          </a>
          <button type="button" class="jobs-compare-btn mt-3 rounded-full border border-outline-variant px-3 py-1 text-label-md font-bold text-primary" data-slug={r.slug}>
            + Compare
          </button>
        </div>
      ))}
    </div>

    <p class="mt-6 text-body-sm text-on-surface-variant">
      Pay figures come from the game client data files and are individually checked; a subset has
      in-game corroboration. See <a href="/sources/" class="text-primary hover:underline">Sources &amp; Verification</a>
      for the method, or open any career for the full L1–L5 ladder with per-field status.
    </p>

    <!-- Compare bar + panel (P1-1) -->
    <div id="jobs-compare-bar" class="sticky bottom-4 mt-6 hidden items-center justify-between gap-3 rounded-card border border-outline-variant/40 bg-inverse-surface p-3 shadow-lg">
      <div id="jobs-compare-names" class="flex flex-wrap items-center gap-2 text-body-md text-inverse-on-surface"></div>
      <div class="flex items-center gap-2">
        <button type="button" id="jobs-compare-clear" class="rounded-full px-3 py-1.5 text-label-md font-bold text-inverse-on-surface hover:opacity-80">Clear</button>
        <button type="button" id="jobs-compare-open" class="rounded-full bg-primary-container px-4 py-1.5 text-label-md font-bold text-on-primary">Compare</button>
      </div>
    </div>
    <div id="jobs-compare-panel" class="mt-6 hidden overflow-x-auto rounded-card border border-outline-variant/40 bg-surface-container-lowest p-4 shadow-sm"></div>
  </div>

  <script is:inline>
    (function () {
      var city = document.getElementById("jobs-city");
      var gate = document.getElementById("jobs-gate");
      var sort = document.getElementById("jobs-sort");
      var count = document.getElementById("jobs-count");
      var tbody = document.getElementById("jobs-tbody");
      var cards = document.getElementById("jobs-cards");
      if (!city || !gate || !sort || !tbody || !cards) return;

      function levelsOf(row) {
        try { return JSON.parse(row.dataset.levels || "{}"); } catch (e) { return {}; }
      }
      function payAt(row, lvl) {
        var v = levelsOf(row)[String(lvl)];
        return typeof v === "number" ? v : null;
      }
      function naira(n) {
        return "₦" + n.toLocaleString("en-NG");
      }

      /* ----- Level switch: swap displayed pay column ----- */
      function renderPay() {
        var lvl = level ? level.value : "1";
        document.querySelectorAll(".job-row").forEach(function (row) {
          var cell = row.querySelector(".js-pay");
          if (!cell) return;
          var p = payAt(row, lvl);
          cell.textContent = p === null ? "Data Pending" : naira(p);
        });
        if (payHead) {
          payHead.textContent =
            lvl === "1" ? "L1 pay / shift (entry)" :
            lvl === "5" ? "L5 pay / shift (top)" :
            "L" + lvl + " pay / shift";
        }
      }

      /* ----- Compare (up to 3 careers) ----- */
      var selected = [];
      var bar = document.getElementById("jobs-compare-bar");
      var names = document.getElementById("jobs-compare-names");
      var panel = document.getElementById("jobs-compare-panel");

      function rowBySlug(slug) {
        var found = null;
        document.querySelectorAll(".job-row").forEach(function (row) {
          var btn = row.querySelector(".jobs-compare-btn");
          if (btn && btn.dataset.slug === slug) found = row;
        });
        return found;
      }

      function renderBar() {
        if (!bar || !names) return;
        bar.classList.toggle("hidden", selected.length === 0);
        bar.classList.toggle("flex", selected.length > 0);
        names.innerHTML = "";
        selected.forEach(function (slug) {
          var row = rowBySlug(slug);
          var chip = document.createElement("span");
          chip.className = "rounded-full bg-surface-container-high px-3 py-1 font-semibold";
          chip.textContent = row ? row.dataset.name : slug;
          names.appendChild(chip);
        });
        var hint = document.createElement("span");
        hint.className = "text-body-sm opacity-70";
        hint.textContent = selected.length + " of 3";
        names.appendChild(hint);
      }

      function renderCompare() {
        if (!panel) return;
        if (selected.length < 2) {
          panel.classList.add("hidden");
          panel.innerHTML = "";
          return;
        }
        var cols = selected.map(function (slug) {
          var row = rowBySlug(slug);
          return row
            ? { slug: slug, name: row.dataset.name, city: row.dataset.city, gate: row.dataset.gate, workplace: row.dataset.workplace, shift: row.dataset.shift, levels: levelsOf(row) }
            : null;
        }).filter(Boolean);

        var attrs = [
          { k: "city", label: "City" },
          { k: "workplace", label: "Workplace" },
          { k: "shift", label: "Shift length" },
          { k: "gate", label: "Skill gate" },
        ];
        var html = '<h2 class="font-headline-sm text-headline-sm font-extrabold text-on-surface">Side-by-side comparison</h2>';
        html += '<table class="mt-3 w-full min-w-[480px] text-left"><thead><tr class="border-b border-outline-variant/40 font-label-md text-label-md font-bold uppercase tracking-wide text-secondary"><th class="px-3 py-2"></th>';
        cols.forEach(function (c) {
          html += '<th class="px-3 py-2"><a class="text-primary hover:underline" href="/jobs/' + c.slug + '/">' + c.name + "</a></th>";
        });
        html += "</tr></thead><tbody>";
        attrs.forEach(function (a) {
          html += '<tr class="border-b border-outline-variant/20"><td class="px-3 py-2 font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">' + a.label + "</td>";
          cols.forEach(function (c) {
            var v = a.k === "shift" ? (c.shift ? c.shift + " h" : "Data Pending") : c[a.k];
            html += '<td class="px-3 py-2 text-body-md text-on-surface">' + (v || "—") + "</td>";
          });
          html += "</tr>";
        });
        for (var lvl = 1; lvl <= 5; lvl++) {
          html += '<tr class="border-b border-outline-variant/20"><td class="px-3 py-2 font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">L' + lvl + " pay / shift</td>";
          cols.forEach(function (c) {
            var p = c.levels[String(lvl)];
            html += '<td class="px-3 py-2 text-body-md font-bold text-on-surface">' + (typeof p === "number" ? naira(p) : "Data Pending") + "</td>";
          });
          html += "</tr>";
        }
        html += "</tbody></table>";
        html += '<p class="mt-3 text-body-sm text-on-surface-variant">Base pay per shift, before adjustments and tax.</p>';
        panel.innerHTML = html;
        panel.classList.remove("hidden");
        panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }

      document.querySelectorAll(".jobs-compare-btn").forEach(function (btn) {
        btn.addEventListener("click", function (e) {
          e.preventDefault();
          e.stopPropagation();
          var slug = btn.dataset.slug;
          var i = selected.indexOf(slug);
          if (i >= 0) selected.splice(i, 1);
          else {
            if (selected.length >= 3) return;
            selected.push(slug);
          }
          btn.textContent = i >= 0 ? "+ Compare" : "✓ Added";
          btn.classList.toggle("bg-surface-container", i < 0);
          renderBar();
          renderCompare();
        });
      });

      var clearBtn = document.getElementById("jobs-compare-clear");
      if (clearBtn) clearBtn.addEventListener("click", function () {
        selected = [];
        document.querySelectorAll(".jobs-compare-btn").forEach(function (b) {
          b.textContent = "+ Compare";
          b.classList.remove("bg-surface-container");
        });
        renderBar();
        renderCompare();
      });
      var openBtn = document.getElementById("jobs-compare-open");
      if (openBtn) openBtn.addEventListener("click", renderCompare);

      function apply() {
        var rows = Array.prototype.slice.call(document.querySelectorAll(".job-row"));
        var visible = 0;
        var lvl = level ? level.value : "1";
        rows.forEach(function (row) {
          var ok =
            (city.value === "all" || row.dataset.city === city.value) &&
            (gate.value === "all" || row.dataset.gated === gate.value);
          row.style.display = ok ? "" : "none";
          if (ok) visible++;
        });
        var sortKey = sort.value;
        var num = function (row) {
          var p = payAt(row, lvl);
          return p === null ? -1 : p;
        };
        rows.sort(function (a, b) {
          var av = num(a);
          var bv = num(b);
          return sortKey.endsWith("asc") ? av - bv : bv - av;
        });
        rows.forEach(function (row) {
          if (row.tagName === "TR") tbody.appendChild(row);
          else cards.appendChild(row);
        });
        if (count) count.textContent = visible + (visible === 1 ? " career" : " careers");
      }

      city.addEventListener("change", apply);
      gate.addEventListener("change", apply);
      sort.addEventListener("change", apply);
      if (level) level.addEventListener("change", function () { renderPay(); apply(); });
      renderPay();
      apply();
    })();
  </script>
</BaseLayout>
