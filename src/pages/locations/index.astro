---
import BaseLayout from "../../layouts/BaseLayout.astro";
import locationsJson from "../../data/locations.json";
import skillsJson from "../../data/skills-actions.json";

/** P1-3 — location hub: every place in the game, with its action count. */

const locations = locationsJson as unknown as {
  id: string;
  name: { value?: string };
  activities?: { value?: string[] };
}[];

const skills = skillsJson as unknown as {
  id: string;
  name: { value?: string };
  locationId?: { value?: string };
}[];

const actionName = new Map(skills.map((a) => [a.id, a.name?.value ?? a.id]));
const actionCount = (locId: string) =>
  skills.filter((a) => a.locationId?.value === locId).length;
/** Human-readable activity names for cards — never raw IDs. */
const activityNames = (loc: { id: string; activities?: { value?: string[] } }): string[] => {
  const listed = loc.activities?.value ?? [];
  const names = listed.map((aid) => actionName.get(aid) ?? aid);
  const extras = skills
    .filter((a) => a.locationId?.value === loc.id && !listed.includes(a.id))
    .map((a) => a.name?.value ?? a.id);
  return [...names, ...extras];
};

const cities: Record<string, string> = {
  lagos: "Lagos",
  abj: "Abuja",
  ph: "Port Harcourt",
};
function cityOf(id: string): string {
  if (id.startsWith("abj")) return cities.abj;
  if (id.startsWith("ph")) return cities.ph;
  return cities.lagos;
}

const sorted = [...locations].sort(
  (a, b) => actionCount(b.id) - actionCount(a.id),
);
---

<BaseLayout
  title="Lagos Life Locations: Every Place & What You Can Do There"
  description="All 43 locations in Lagos Life — markets, campuses, clubs, beaches, stadiums — with opening hours and a complete list of the actions available at each, every figure dated."
  canonicalPath="/locations/"
  ogImage="/images/og-locations.jpg"
>
  <div class="mx-auto max-w-[1200px] px-margin py-space-xl md:px-margin-tablet lg:px-margin-desktop">
    <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-label-md text-on-surface-variant">
      <a href="/" class="hover:text-primary">Home</a>
      <span class="text-outline" aria-hidden="true">/</span>
      <span aria-current="page" class="text-on-surface">Locations</span>
    </nav>

    <h1 class="text-display-hero-mobile font-extrabold tracking-tight text-on-surface md:text-display-hero">
      Lagos Life Locations
    </h1>
    <p class="mt-4 max-w-3xl text-body-lg leading-relaxed text-on-surface-variant">
      Every place you can visit in the game — what it is, when it opens, and each action you
      can do there with its cost and duration. Every figure carries its own check date.
    </p>

    <div class="mt-space-lg grid gap-space-sm sm:grid-cols-2 lg:grid-cols-3">
      {sorted.map((loc) => {
        const n = actionCount(loc.id);
        return (
          <a
            href={`/locations/${loc.id}/`}
            class="group rounded-2xl border border-outline-variant/40 bg-surface-container-lowest p-space-md transition-all hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-md"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="rounded-full bg-surface-container px-2.5 py-0.5 font-label-sm text-label-sm font-bold text-on-surface-variant">
                {cityOf(loc.id)}
              </span>
              <span class="font-label-sm text-label-sm font-bold text-primary">
                {n} action{n === 1 ? "" : "s"}
              </span>
            </div>
            <h2 class="mt-2 font-headline-sm text-headline-sm font-extrabold text-on-surface group-hover:text-primary">
              {loc.name.value ?? loc.id}
            </h2>
            {(() => {
              const names = activityNames(loc);
              return names.length > 0 ? (
                <p class="mt-1 line-clamp-2 text-body-sm text-on-surface-variant">
                  {names.slice(0, 4).join(" · ")}{names.length > 4 ? ` · +${names.length - 4} more` : ""}
                </p>
              ) : null;
            })()}
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
