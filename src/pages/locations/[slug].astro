---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VerificationBadge from "../../components/VerificationBadge.astro";
import locationsJson from "../../data/locations.json";
import skillsJson from "../../data/skills-actions.json";
import jobsJson from "../../data/jobs.json";

/** P1-3 — location detail: opening hours + every action available at this place. */

export function getStaticPaths() {
  return (locationsJson as unknown as { id: string }[]).map((l) => ({
    params: { slug: l.id },
  }));
}

const { slug } = Astro.params;
const locations = locationsJson as unknown as {
  id: string;
  name: { value?: string; status?: string };
  activities?: { value?: string; status?: string; checkedAt?: string };
  openingHours?: { value?: string; status?: string; checkedAt?: string };
}[];
const loc = locations.find((l) => l.id === slug)!;

const skills = (skillsJson as unknown as {
  id: string;
  name: { value?: string };
  durationMinutes?: { value?: number };
  costAmount?: { value?: number | null; status?: string };
  effectDescription?: { value?: string; status?: string; checkedAt?: string };
  locationId?: { value?: string };
}[]).filter((a) => a.locationId?.value === slug);

const careers = (jobsJson as unknown as {
  id: string;
  name: { value?: string };
  workplace?: { value?: string };
}[]).filter((j) => j.workplace?.value === slug);

const titleName = loc.name.value ?? slug;
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: `What can you do at ${titleName} in Lagos Life?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: `${skills.length} actions are recorded at ${titleName} in the game's data${careers.length > 0 ? `, and it is the workplace for the ${careers.map((c) => c.name.value).join(" and ")} career${careers.length > 1 ? "s" : ""}` : ""}. Each action's duration, cost and effect carry their own verification status and check date.`,
      },
    },
  ],
};
---

<BaseLayout
  title={`${titleName}: Hours & Every Action – Lagos Life Locations | LagosLifeGuide`}
  description={`${titleName} in Lagos Life — opening hours and all ${skills.length} recorded actions with duration, cost and effects, each figure verified and dated.`}
  canonicalPath={`/locations/${slug}/`}
  jsonLd={[faqJsonLd]}
  ogImage="/images/og-locations.jpg"
>
  <div class="mx-auto max-w-[1100px] px-margin py-space-xl md:px-margin-tablet lg:px-margin-desktop">
    <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-label-md text-on-surface-variant">
      <a href="/" class="hover:text-primary">Home</a>
      <span class="text-outline" aria-hidden="true">/</span>
      <a href="/locations/" class="hover:text-primary">Locations</a>
      <span class="text-outline" aria-hidden="true">/</span>
      <span aria-current="page" class="text-on-surface">{titleName}</span>
    </nav>

    <div class="flex flex-wrap items-center gap-2">
      <VerificationBadge status={(loc.name.status as never) ?? "unverified"} />
      <span class="rounded-full bg-surface-container px-2.5 py-0.5 font-label-sm text-label-sm text-on-surface-variant">
        ID: {slug}
      </span>
    </div>
    <h1 class="mt-2 text-display-hero-mobile font-extrabold tracking-tight text-on-surface md:text-display-hero">
      {titleName}
    </h1>
    {loc.activities?.value && (
      <p class="mt-3 max-w-3xl text-body-lg leading-relaxed text-on-surface-variant">{loc.activities.value}</p>
    )}

    <dl class="mt-6 grid gap-3 sm:grid-cols-2">
      <div class="rounded-2xl bg-surface-container-low p-space-md">
        <dt class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">Opening hours</dt>
        <dd class="mt-1 text-body-lg font-semibold text-on-surface">
          {loc.openingHours?.value ?? "Data Pending"}
          {loc.openingHours?.checkedAt && (
            <span class="ml-2 text-body-sm font-normal text-on-surface-variant">checked {loc.openingHours.checkedAt}</span>
          )}
        </dd>
      </div>
      <div class="rounded-2xl bg-surface-container-low p-space-md">
        <dt class="font-label-md text-label-md font-bold uppercase tracking-wide text-secondary">Raw data record</dt>
        <dd class="mt-1 text-body-lg font-semibold">
          <a href={`/game-data/${slug}/`} class="text-primary hover:underline">Field-level audit page →</a>
        </dd>
      </div>
    </dl>

    <h2 class="mt-space-lg font-headline-md text-headline-md font-extrabold text-on-surface">
      All {skills.length} action{skills.length === 1 ? "" : "s"} at {titleName}
    </h2>
    {skills.length === 0 ? (
      <p class="mt-2 text-body-md text-on-surface-variant">No actions are recorded at this location in the current data.</p>
    ) : (
      <ul class="mt-space-sm grid gap-space-sm sm:grid-cols-2">
        {skills.map((a) => (
          <li>
            <a
              href={`/game-data/${a.id}/`}
              class="group flex h-full flex-col rounded-2xl border border-outline-variant/40 bg-surface-container-lowest p-space-md transition-all hover:-translate-y-0.5 hover:border-primary/50"
            >
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="font-headline-sm text-headline-sm font-extrabold text-on-surface group-hover:text-primary">
                  {a.name.value ?? a.id}
                </h3>
                {a.durationMinutes?.value != null && (
                  <span class="shrink-0 text-body-sm text-on-surface-variant">{a.durationMinutes.value} min</span>
                )}
              </div>
              <p class="mt-1 text-body-sm text-on-surface-variant">
                {a.costAmount?.value != null
                  ? `₦${a.costAmount.value.toLocaleString("en-NG")}`
                  : a.costAmount?.status === "unverified"
                    ? "Cost: Data Pending"
                    : ""}
              </p>
            </a>
          </li>
        ))}
      </ul>
    )}

    {careers.length > 0 && (
      <>
        <h2 class="mt-space-lg font-headline-md text-headline-md font-extrabold text-on-surface">Careers based here</h2>
        <ul class="mt-space-sm grid gap-space-sm sm:grid-cols-2">
          {careers.map((c) => (
            <li>
              <a href={`/jobs/${c.id}/`} class="group block rounded-2xl border border-outline-variant/40 bg-surface-container-lowest p-space-md transition-all hover:-translate-y-0.5 hover:border-primary/50">
                <h3 class="font-headline-sm text-headline-sm font-extrabold text-on-surface group-hover:text-primary">{c.name.value}</h3>
                <p class="mt-1 text-body-sm text-on-surface-variant">Full pay ladder and requirements →</p>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</BaseLayout>
