---
import BaseLayout from "../layouts/BaseLayout.astro";
import jobs from "../data/jobs.json";
import housingCosts from "../data/housing-costs.json";
import skillsActions from "../data/skills-actions.json";
import locations from "../data/locations.json";

/**
 * P1-2 — /updates/: every record with a real review date, newest first.
 * Dates come straight from the data files (field checkedAt values) — nothing
 * here is written by hand, so the page updates itself as records are re-checked.
 */

function fieldCheckedAt(r: Record<string, unknown>): string {
  for (const v of Object.values(r)) {
    if (v && typeof v === "object" && "checkedAt" in (v as Record<string, unknown>)) {
      const c = (v as { checkedAt?: string }).checkedAt;
      if (typeof c === "string") return c;
    }
  }
  return "";
}
function fieldName(r: Record<string, unknown>): string {
  const n = r.name as { value?: unknown } | undefined;
  return typeof n?.value === "string" ? n.value : String(r.id ?? "");
}

type Row = { href: string; name: string; collection: string; date: string };
const rows: Row[] = [
  ...(jobs as unknown as Record<string, unknown>[]).map((r) => ({
    r,
    href: `/jobs/${r.id}/`,
    collection: "Jobs",
  })),
  ...(housingCosts as unknown as Record<string, unknown>[]).map((r) => ({
    r,
    href: `/game-data/${r.id}/`,
    collection: "Housing & Costs",
  })),
  ...(skillsActions as unknown as Record<string, unknown>[]).map((r) => ({
    r,
    href: `/game-data/${r.id}/`,
    collection: "Skills & Actions",
  })),
  ...(locations as unknown as Record<string, unknown>[]).map((r) => ({
    r,
    href: `/game-data/${r.id}/`,
    collection: "Locations",
  })),
]
  .map(({ r, href, collection }) => ({
    href,
    name: fieldName(r),
    collection,
    date: fieldCheckedAt(r),
  }))
  .filter((x) => x.date)
  .sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : a.name.localeCompare(b.name)));

const byDate = new Map<string, Row[]>();
for (const row of rows) {
  const list = byDate.get(row.date) ?? [];
  list.push(row);
  byDate.set(row.date, list);
}
const dates = [...byDate.keys()].sort((a, b) => (a < b ? 1 : -1));

const collectionChip: Record<string, string> = {
  Jobs: "bg-primary-fixed/40 text-primary",
  "Housing & Costs": "bg-secondary-fixed/40 text-secondary",
  "Skills & Actions": "bg-tertiary-fixed/40 text-tertiary",
  Locations: "bg-surface-container-high text-on-surface-variant",
};
---

<BaseLayout
  title="Recent Updates: What We Re-Checked & When – LagosLifeGuide"
  description="Every Lagos Life record carries its own check date. This page lists the most recently reviewed records and guides, newest first — updated automatically from our data."
  canonicalPath="/updates/"
  ogImage="/images/og-updates.jpg"
>
  <div class="mx-auto max-w-[920px] px-margin py-space-xl md:px-margin-tablet lg:px-margin-desktop">
    <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-label-md text-on-surface-variant">
      <a href="/" class="hover:text-primary">Home</a>
      <span class="text-outline" aria-hidden="true">/</span>
      <span aria-current="page" class="text-on-surface">Recent Updates</span>
    </nav>

    <h1 class="text-display-hero-mobile font-extrabold tracking-tight text-on-surface md:text-display-hero">
      Recent Updates
    </h1>
    <p class="mt-4 max-w-2xl text-body-lg leading-relaxed text-on-surface-variant">
      Every figure on this site carries the date it was last checked against the game or its
      data files. This page collects those dates so freshness is visible at a glance —
      it is generated from the data itself, so it can never drift out of date.
    </p>

    <div class="mt-space-lg space-y-space-lg">
      {dates.map((date) => (
        <section>
          <h2 class="flex items-center gap-3 font-headline-sm text-headline-sm font-extrabold text-on-surface">
            <time datetime={date}>{date}</time>
            <span class="h-px flex-1 bg-outline-variant/40" aria-hidden="true" />
            <span class="text-body-sm font-normal text-on-surface-variant">
              {byDate.get(date)!.length} record{byDate.get(date)!.length === 1 ? "" : "s"}
            </span>
          </h2>
          <ul class="mt-space-sm grid gap-space-sm sm:grid-cols-2">
            {byDate.get(date)!.map((row) => (
              <li class="flex items-center justify-between gap-space-sm rounded-2xl border border-outline-variant/40 bg-surface-container-lowest px-space-md py-space-sm">
                <div class="min-w-0">
                  <a href={row.href} class="block truncate font-headline-sm text-headline-sm font-bold text-on-surface hover:text-primary">
                    {row.name}
                  </a>
                  <span class={`mt-1 inline-block rounded-full px-2 py-0.5 text-label-sm font-bold ${collectionChip[row.collection] ?? "bg-surface-container-high text-on-surface-variant"}`}>
                    {row.collection}
                  </span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
