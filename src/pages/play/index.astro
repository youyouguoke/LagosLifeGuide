---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NextSteps from "../../components/NextSteps.astro";

const officialUrl = "https://lagoslife.app";

const symptoms = [
  {
    t: "Blank page or endless spinner",
    d: "Open the address in a regular browser (Chrome, Safari, Edge), not inside a social app's embedded browser. Use one tab only, check your connection, then reload the official address.",
  },
  {
    t: "Game loads but keeps reconnecting",
    d: "Close duplicate tabs, switch from Wi-Fi to mobile data (or back) once to isolate the network, and avoid VPNs that bounce your region mid-session.",
  },
  {
    t: "Signed out and cannot get back in",
    d: "Re-open lagoslife.app and use the sign-in option shown by the game itself. Only clear site data as a last resort — and only if you are sure you can sign back into your saved account afterwards.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is the Lagos Life game link?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The current entry address is https://lagoslife.app (the developer's own domain lagoslife.eliysites.com serves the same app). Last checked 2026-10-22. LagosLifeGuide.app is an unofficial fan guide — we link to the game but do not host it.",
      },
    },
    {
      "@type": "Question",
      name: "How do I log in to Lagos Life?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Open lagoslife.app and use the sign-in option shown by the game with the username and password you registered with. If login fails, see our login help page for step-by-step fixes. Never enter your password on any site other than the official game.",
      },
    },
    {
      "@type": "Question",
      name: "Is there a Lagos Life app?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "The official game is a browser app — it installs on your phone or PC as a PWA (progressive web app): open lagoslife.app in Chrome or Edge and use \"Add to Home Screen\" / \"Install app\". Play Store titles named Lagos Life from other operators are different games. See our app page for steps.",
      },
    },
    {
      "@type": "Question",
      name: "Can I play Lagos Life on PC?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. The game runs in a desktop browser at lagoslife.app with the same account as on mobile — log in on either device and your progress follows your account.",
      },
    },
    {
      "@type": "Question",
      name: "Is LagosLifeGuide.app the official Lagos Life site?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No. This is an unofficial fan guide with verified game data (sources and check dates on our sources page). The official game is only at lagoslife.app. We will never ask for your game password.",
      },
    },
  ],
};

const faqs = faqJsonLd.mainEntity.map((q) => ({ q: q.name, a: q.acceptedAnswer.text }));
---

<BaseLayout
  title="Lagos Life Game Login, Link & Play Online (Unofficial Guide)"
  description="Where to play Lagos Life: game link, login help, website and app install steps for phone and PC. Checked October 2026. Unofficial fan guide."
  canonicalPath="/play/"
  ogImage="/images/og-play.jpg"
  jsonLd={[faqJsonLd]}
>
  <section class="mx-auto max-w-[1280px] px-margin py-space-xl md:px-margin-tablet lg:px-margin-desktop">
    <div class="mb-space-xs inline-flex items-center gap-1.5 rounded-full bg-surface-container px-3 py-1 text-label-sm font-bold text-primary">
      Official Access
    </div>
    <h1 class="text-display-hero-mobile font-extrabold tracking-tight text-inverse-surface md:text-display-hero">
      Lagos Life Game – Link, Login and App Install
    </h1>
    <p class="mt-space-sm max-w-3xl text-body-lg leading-relaxed text-on-surface-variant">
      <strong class="text-on-surface">Lagos Life plays in your browser at lagoslife.app</strong> — no
      download needed, just log in with the account you registered in-game. You can also install it as
      an app on your phone or PC. This is an unofficial fan guide: we link to the game, we don't host it
      and we never ask for your password.
    </p>

    <div class="mt-space-md flex flex-wrap items-center gap-3">
      <a
        href="https://lagoslife.app"
        data-official-link="lagoslife.app"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-label-lg font-bold text-on-primary transition hover:opacity-90"
      >Play Lagos Life</a>
      <a
        href="/login-help/"
        class="inline-flex items-center gap-2 rounded-full border-2 border-primary px-5 py-2.5 text-label-lg font-bold text-primary transition hover:bg-surface-container"
      >Login help</a>
      <a
        href="/app/"
        class="inline-flex items-center gap-2 rounded-full border-2 border-primary px-5 py-2.5 text-label-lg font-bold text-primary transition hover:bg-surface-container"
      >Install app</a>
    </div>
    <p class="mt-3 text-body-sm text-on-surface-variant">
      Last checked: <strong class="text-on-surface">2026-10-22</strong> · Official address:
      <a href="https://lagoslife.app" class="text-primary hover:underline" rel="noopener">lagoslife.app</a>
    </p>

    <!-- Official link card -->
    <div class="mt-space-lg rounded-3xl bg-surface-container-low p-space-md sm:p-space-lg">
      <div class="flex flex-col items-start justify-between gap-space-md md:flex-row md:items-center">
        <div>
          <p class="text-label-sm font-bold uppercase tracking-wider text-primary">Official game</p>
          <p class="mt-1 text-headline-lg font-bold text-inverse-surface">
            <a href={officialUrl} target="_blank" rel="noopener" class="text-primary underline decoration-wavy underline-offset-4 hover:text-brand-dark">{officialUrl}</a>
          </p>
          <p class="mt-2 max-w-2xl text-body-md text-on-surface-variant">
            The site's own manifest describes it as "Sims, but make it Eko. A life-sim set in
            Lagos, with real players." It installs as a standalone web app (PWA) — see our
            <a href="/download/" class="font-semibold text-primary hover:underline">download &amp; install guide</a>
            and <a href="/app/" class="font-semibold text-primary hover:underline">phone guide</a>.
          </p>
        </div>
        <a
          href={officialUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex shrink-0 items-center justify-center rounded-full bg-primary-container px-space-lg py-3 text-label-lg font-semibold text-on-primary transition-colors hover:bg-primary"
        >
          Open the official game
        </a>
      </div>
      <p class="mt-space-md rounded-xl bg-surface-container-lowest p-space-sm text-body-sm text-on-surface-variant">
        Safety rule #1: read the address bar before typing any password. The game's main address
        is <strong class="font-semibold text-on-surface">lagoslife.app</strong> — not this guide
        site, not any look-alike domain. We verified on 2026-10-19 that
        <strong class="font-semibold text-on-surface">lagoslife.eliysites.com</strong> (the
        developer's own infrastructure domain — Eliy, named in the official terms) serves the same
        app; we still link only lagoslife.app.
      </p>
    </div>

    <!-- Which site is official -->
    <div class="mt-space-xl grid gap-space-md md:grid-cols-2">
      <div class="rounded-3xl border border-outline-variant/50 bg-surface p-space-md">
        <h2 class="text-headline-md font-semibold text-inverse-surface">Which Lagos Life is this?</h2>
        <p class="mt-space-xs text-body-md text-on-surface-variant">
          This guide covers the browser game at <strong class="font-semibold text-on-surface">lagoslife.app only</strong>.
          Other sites and apps using the same or similar names — including lagoslife.com.ng, a
          different game from operator GreatCallie — are separate games. Their data, accounts, and
          prices do not transfer, and our datasets do not describe them.
        </p>
      </div>
      <div class="rounded-3xl border border-outline-variant/50 bg-surface p-space-md">
        <h2 class="text-headline-md font-semibold text-inverse-surface">Saving progress</h2>
        <p class="mt-space-xs text-body-md text-on-surface-variant">
          The game offers account sign-in, and we recommend using it before your first session goes
          long. The exact sign-in options are part of the game client and can change; trust only
          the options the game itself shows you at lagoslife.app — never a form on any third-party
          site asking for your game password.
        </p>
      </div>
    </div>

    <!-- Troubleshooting -->
    <div class="mt-space-xl">
      <h2 class="text-headline-lg font-bold text-inverse-surface">If the official link will not load</h2>
      <div class="mt-space-md grid gap-space-md md:grid-cols-3">
        {symptoms.map((s) => (
          <div class="rounded-2xl bg-surface-container-low p-space-md">
            <h3 class="text-headline-sm font-semibold text-on-surface">{s.t}</h3>
            <p class="mt-space-xs text-body-md text-on-surface-variant">{s.d}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Game preview -->
    <div class="mt-space-xl">
      <h2 class="text-headline-lg font-bold text-inverse-surface">What the game looks like</h2>
      <p class="mt-space-xs max-w-3xl text-body-md text-on-surface-variant">
        Unedited screenshots from a real session on the official instance — the city map, a
        campus morning at UNILAG, and the beach on a sunny in-game day.
      </p>
      <div class="mt-space-md grid gap-space-md md:grid-cols-3">
        <figure class="overflow-hidden rounded-2xl border border-outline-variant/40 bg-surface-container-lowest shadow-sm">
          <img
            src="/images/gameplay/lagos-city-map.png"
            alt="Lagos Life city map with location pins for Quilox, the beach, UNILAG, Balogun Market and more"
            loading="lazy"
            decoding="async"
            class="h-auto w-full"
          />
          <figcaption class="px-space-md py-space-sm text-body-sm text-on-surface-variant">
            The Lagos map: 30+ locations, all walkable in-game. Captured at lagoslife.app · 14 Oct 2026.
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-2xl border border-outline-variant/40 bg-surface-container-lowest shadow-sm">
          <img
            src="/images/gameplay/campus-unilag-where-to.png"
            alt="Lagos Life UNILAG campus scene on a sunny morning with the character outside the halls"
            loading="lazy"
            decoding="async"
            class="h-auto w-full"
          />
          <figcaption class="px-space-md py-space-sm text-body-sm text-on-surface-variant">
            Morning outside the UNILAG halls of residence. Captured at lagoslife.app · 14 Oct 2026.
          </figcaption>
        </figure>
        <figure class="overflow-hidden rounded-2xl border border-outline-variant/40 bg-surface-container-lowest shadow-sm">
          <img
            src="/images/gameplay/beach-scene.png"
            alt="Lagos Life beach location scene with palm trees and other players around"
            loading="lazy"
            decoding="async"
            class="h-auto w-full"
          />
          <figcaption class="px-space-md py-space-sm text-body-sm text-on-surface-variant">
            The beach, one of the free leisure spots. Captured at lagoslife.app · 14 Oct 2026.
          </figcaption>
        </figure>
      </div>
    </div>

    <NextSteps />

    <!-- FAQ -->
    <div class="mt-space-xl rounded-3xl bg-surface-container-low/50 p-space-md sm:p-space-lg">
      <h2 class="text-headline-lg font-bold text-inverse-surface">Quick answers</h2>
      <div class="mt-space-md space-y-space-md">
        {faqs.map((f) => (
          <div>
            <h3 class="text-headline-sm font-semibold text-on-surface">{f.q}</h3>
            <p class="mt-1 text-body-md text-on-surface-variant">{f.a}</p>
          </div>
        ))}
      </div>
    </div>

    <p class="mt-space-lg text-body-sm text-text-muted">
      Last reviewed 2026-10-10. The official-link facts (address, manifest description, PWA
      capability) were verified against the game's own site files. Browser menu steps are general
      knowledge and can vary by version. See something changed?
      Use the feedback button (bottom-right) — pick "Correction".
    </p>
  </section>
</BaseLayout>
