---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import EmptyState from "../../components/EmptyState.astro";
import DataRecordCard from "../../components/DataRecordCard.astro";
import { allRecords, collections } from "../../lib/game-data";

const nonEmptyCollections = collections.filter((c) => c.records.length > 0);
const totalCount = allRecords.length;

// Lowercased haystack per record: name + type + key field labels/values.
const cards = allRecords.map((rec) => ({
  ...rec,
  searchText: [
    rec.name,
    rec.typeLabel,
    ...rec.keyFields.flatMap((kf) => [kf.label, kf.value]),
  ]
    .join(" ")
    .toLowerCase(),
}));
---

<BaseLayout
  title="Game Data — LagosLifeGuide.app"
  description="Verified Lagos Life game data: jobs, housing and living costs, skills and actions, and locations. Every field is verified individually against cited sources."
  canonicalPath="/game-data/"
>
  <section class="mx-auto max-w-[1280px] px-margin py-space-xl md:px-margin-tablet lg:px-margin-desktop">
    <SectionHeader
      eyebrow="Game Data"
      title="Game Data"
      subtitle="Every field in this reference is verified individually against cited sources before it is published. Anything we could not confirm is shown as “Not yet verified” — never guessed, and never replaced with zero."
    />

    {
      totalCount === 0 ? (
        <div class="mt-space-xl">
          <EmptyState
            title="No verified records yet"
            description="We publish game data only after each field has been checked against a cited source. No record has passed that bar yet — so instead of guessing, we show nothing. Read about the sources we are reviewing and how verification works."
            actionHref="/sources/"
            actionLabel="See our sources & method"
          />
        </div>
      ) : (
        <>
          <div class="mt-space-lg flex flex-col gap-space-md">
            <div>
              <label for="game-data-search" class="text-label-lg font-semibold text-on-surface">
                Search records
              </label>
              <input
                id="game-data-search"
                type="search"
                autocomplete="off"
                placeholder="Search by name, type, or field value…"
                class="mt-space-xs w-full rounded-xl border border-border bg-surface-container-lowest px-space-md py-3 text-body-lg text-on-surface shadow-sm outline-none placeholder:text-text-muted focus:border-focus focus:ring-2 focus:ring-focus/30"
              />
            </div>

            {nonEmptyCollections.length > 0 && (
              <div class="flex flex-wrap items-center gap-space-xs" role="group" aria-label="Filter by category">
                <button
                  type="button"
                  data-collection-chip="all"
                  aria-pressed="true"
                  class="chip rounded-full bg-primary px-4 py-2 text-label-lg font-semibold text-on-primary transition-colors hover:bg-primary-container"
                >
                  All · {totalCount}
                </button>
                {nonEmptyCollections.map((col) => (
                  <button
                    type="button"
                    data-collection-chip={col.key}
                    aria-pressed="false"
                    class="chip rounded-full bg-surface-container-lowest px-4 py-2 text-label-lg font-semibold text-on-surface-variant shadow-sm transition-colors hover:bg-surface-container"
                  >
                    {col.chipLabel} · {col.records.length}
                  </button>
                ))}
              </div>
            )}
          </div>

          <p class="mt-space-md text-body-md text-text-muted" aria-live="polite">
            Showing <span id="game-data-shown">{totalCount}</span> of {totalCount} records
          </p>

          <div id="game-data-list" class="mt-space-sm grid gap-space-md lg:grid-cols-2">
            {cards.map((rec) => (
              <DataRecordCard
                href={`/game-data/${rec.slug}/`}
                name={rec.name}
                typeLabel={rec.typeLabel}
                status={rec.status}
                keyFields={rec.keyFields}
                collection={rec.collection}
                searchText={rec.searchText}
              />
            ))}
          </div>

          <div id="game-data-no-results" class="mt-space-md hidden">
            <EmptyState
              title="No matching records"
              description="No verified record matches that search. Try a different term, or clear the category filter."
            />
          </div>
        </>
      )
    }
  </section>
</BaseLayout>

<script>
  // Client-side search + category filter across all collections (UIUX §8.1).
  const searchInput = document.getElementById("game-data-search") as HTMLInputElement | null;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-collection-chip]"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-record-card]"));
  const noResults = document.getElementById("game-data-no-results");
  const shownCount = document.getElementById("game-data-shown");

  let activeCollection = "all";

  function applyFilters(): void {
    const query = (searchInput?.value ?? "").trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const inCategory = activeCollection === "all" || card.dataset.collection === activeCollection;
      const inSearch = query === "" || (card.dataset.search ?? "").includes(query);
      const show = inCategory && inSearch;
      card.classList.toggle("hidden", !show);
      if (show) visible += 1;
    }
    noResults?.classList.toggle("hidden", visible !== 0);
    if (shownCount) shownCount.textContent = String(visible);
  }

  searchInput?.addEventListener("input", applyFilters);

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      activeCollection = chip.dataset.collectionChip ?? "all";
      for (const other of chips) {
        const active = other === chip;
        other.setAttribute("aria-pressed", String(active));
        other.classList.toggle("bg-primary", active);
        other.classList.toggle("text-on-primary", active);
        other.classList.toggle("bg-surface-container-lowest", !active);
        other.classList.toggle("text-on-surface-variant", !active);
      }
      applyFilters();
    });
  }
</script>
