---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  /** Canonical path without origin, e.g. "/game-data/". Defaults to current path. */
  canonicalPath?: string;
  noindex?: boolean;
  /** Additional JSON-LD nodes (Article, BreadcrumbList, ...). */
  jsonLd?: object[];
  /** Per-page share image, absolute path under public/, e.g. "/images/og-jobs.jpg". */
  ogImage?: string;
  /** Open Graph type; "article" for guides, "website" elsewhere. */
  ogType?: "website" | "article";
}

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  jsonLd = [],
  ogImage = "/images/og-default.jpg",
  ogType = "website",
} = Astro.props;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "LagosLifeGuide.app",
  url: Astro.site?.toString(),
  description:
    "Independent Lagos Life guides, verified game data, and a first-week planner. Not affiliated with the game's developer.",
};
const graph = [websiteLd, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Open Graph / Twitter (P0-6; per-page images P0-2) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="LagosLifeGuide" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="180x180" href="/favicon-180.png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <script defer data-domain="lagoslifeguide.app" src="https://plausible.shipsolo.io/js/script.js"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QD0HMYX9PP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QD0HMYX9PP');
    </script>
    <!-- P0-3: measure outbound clicks to the official game (event only, no personal data) -->
    <script is:inline>
      document.addEventListener("click", function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href^="https://lagoslife.app"]') : null;
        if (!a) return;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: "outbound_official_click", page: location.pathname });
      });
    </script>
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />
    <script
      defer
      src="https://feedback-hub.youyouguoke.workers.dev/widget.js"
      data-site-id="lagoslifeguide"></script>
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <SiteHeader />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
